# Copy to .env and fill in. `docker compose up` refuses to start without JWT_SECRET.
#
#   cp .env.example .env
#   printf 'JWT_SECRET=%s\n' "$(openssl rand -base64 64 | tr -d '\n')" >> .env

# Base64-encoded 512-bit signing key. Generate your own — never reuse this file's
# placeholder, and never commit a real one.
JWT_SECRET=

# Postgres password. The default matches docker-compose's fallback, which is fine
# locally and must be changed anywhere else.
DB_PASSWORD=sprintiq

# `mock` runs the four AI models as deterministic heuristics with no Python service.
# Switch to `http` once a model gateway is running.
AI_PROVIDER=mock

# Origins allowed to call the API. The Next dev server is on 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# The narrative risk advisor (Gemini). Empty means off: this is the only model in the
# product that posts sprint data — task titles, risk drivers, findings — to a third
# party, so it stays disabled until somebody turns it on knowingly. Get a key from
# https://aistudio.google.com/apikey.
#
# Only `docker compose` reads this file. Running the backend straight from the IDE or
# `make backend` needs the variable in the shell instead:
#
#   export ADVISOR_API_KEY=...
ADVISOR_API_KEY=

# The model behind it. Any model the Gemini OpenAI-compatible endpoint serves.
ADVISOR_MODEL=gemini-3.5-flash

# The same key and model also power the Copilot (/copilot), which calls all four models
# as tools and sends the figures it looks up to this provider. The model must support
# tool calling — gemini-3.5-flash does. Google retires models without notice: a 404 from
# the advisor means this name is no longer served, so pick one from the models list.
